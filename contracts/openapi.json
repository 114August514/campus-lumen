{
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "properties": {
          "code": {
            "description": "Stable snake_case application error code.",
            "type": "string"
          },
          "details": {
            "description": "Optional structured error details.",
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "type": "object"
      },
      "CapabilityFlags": {
        "properties": {
          "aiArchiveEnabled": {
            "type": "boolean"
          },
          "attachmentsEnabled": {
            "type": "boolean"
          },
          "authMockEnabled": {
            "type": "boolean"
          },
          "desktopEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "authMockEnabled",
          "desktopEnabled",
          "aiArchiveEnabled",
          "attachmentsEnabled"
        ],
        "type": "object"
      },
      "DiscoveryLimits": {
        "properties": {
          "maxHttpRequests": {
            "type": "integer"
          },
          "maxPageBytes": {
            "type": "integer"
          },
          "maxReads": {
            "type": "integer"
          },
          "maxSeconds": {
            "type": "integer"
          },
          "maxSources": {
            "type": "integer"
          }
        },
        "required": [
          "maxSeconds",
          "maxSources",
          "maxReads",
          "maxHttpRequests",
          "maxPageBytes"
        ],
        "type": "object"
      },
      "DiscoveryRequest": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "description": "Public interest terms sent to DuckDuckGo, or one complete HTTP(S) URL within the academic/recruitment host-and-path allowlist, read directly without search or directory fallback. Invalid or unsupported URLs are rejected. No private notes, identities, credentials or private links.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "DiscoveryResponse": {
        "properties": {
          "collectedAt": {
            "format": "date-time",
            "type": "string"
          },
          "completedReads": {
            "type": "integer"
          },
          "finished": {
            "type": "boolean"
          },
          "limits": {
            "$ref": "#/components/schemas/DiscoveryLimits"
          },
          "provider": {
            "enum": [
              "duckduckgo_html",
              "official_directory",
              "direct_url"
            ],
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "scope": {
            "description": "Actual provider and bounded reading scope for this attempt.",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/DiscoverySource"
            },
            "type": "array"
          },
          "startedReads": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "failed"
            ],
            "type": "string"
          },
          "stopReason": {
            "enum": [
              "",
              "time_limit",
              "source_limit"
            ],
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/DiscoveryWarning"
            },
            "type": "array"
          }
        },
        "required": [
          "query",
          "provider",
          "scope",
          "status",
          "collectedAt",
          "sources",
          "warnings",
          "finished",
          "stopReason",
          "startedReads",
          "completedReads",
          "limits"
        ],
        "type": "object"
      },
      "DiscoverySource": {
        "properties": {
          "collectedAt": {
            "format": "date-time",
            "type": "string"
          },
          "content": {
            "description": "Fetched HTML text; maximum 16000 characters, not a generated summary.",
            "type": "string"
          },
          "institution": {
            "description": "Source hostname, not a verified institutional affiliation.",
            "type": "string"
          },
          "publishedAt": {
            "description": "Unverified original date metadata when present, never inferred from collection time.",
            "type": "string"
          },
          "relevanceEvidence": {
            "description": "Up to three body passages matching query terms; no model judgment. Empty for direct URL reading, which makes no query-relevance claim.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "searchSnippet": {
            "description": "Search-index snippet, kept separate from fetched body; empty for direct URL reading.",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "unknowns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "institution",
          "content",
          "searchSnippet",
          "relevanceEvidence",
          "collectedAt",
          "unknowns"
        ],
        "type": "object"
      },
      "DiscoveryWarning": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "MetaResponse": {
        "properties": {
          "appName": {
            "const": "Campus Lumen",
            "type": "string"
          },
          "capabilities": {
            "$ref": "#/components/schemas/CapabilityFlags"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "appName",
          "version",
          "capabilities"
        ],
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "postgres": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "postgres"
        ],
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": [
              "ready",
              "unready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Campus Lumen API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/discoveries": {
      "post": {
        "description": "DuckDuckGo公开索引中的高校、研究所和已核对学术主页，以及限定路径内的微软研究招聘、上海AI实验室招聘、字节校园职位页和OpenCompass仓库。最多读取5个公开HTML页面；不覆盖全网、私域、PDF、需登录或必须运行JavaScript的页面。 仅直接读取所提交的一个范围内公开HTML页面（含通过相同校验的重定向），不使用搜索索引或备用目录；最多1,000,000字节、14秒，提取正文最多16,000字。未判断该页是否回答当前疑问，请阅读正文并核对对象；完整内容请到原站查看。",
        "operationId": "discoverSources",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoveryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryResponse"
                }
              },
              "application/x-ndjson": {
                "description": "One cumulative DiscoveryResponse per line, initially finished=false and finally finished=true. Dropping the response cancels server work; completed sources in prior lines remain available to the client.",
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryResponse"
                }
              }
            },
            "description": "Live attempt, including explicit partial or failed results; never cached demo replacements"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Request body exceeds configured limit"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Invalid public query"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Two discovery requests already running"
          }
        },
        "security": [],
        "summary": "Live public-index search or direct reading of one allowed academic or recruitment HTML URL"
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "getMeta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            },
            "description": "Application metadata"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "security": [],
        "summary": "Application metadata and capability flags"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "const": "ok",
                  "type": "string"
                }
              }
            },
            "description": "API process is alive"
          }
        },
        "security": [],
        "summary": "Health check"
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "API dependencies are ready"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "API dependencies are not ready"
          }
        },
        "security": [],
        "summary": "Readiness check"
      }
    }
  }
}
